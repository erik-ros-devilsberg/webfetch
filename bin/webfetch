#!/usr/bin/env php
<?php

declare(strict_types=1);

// Resolve the autoloader whether running from this repo or as an
// installed Composer binary.
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit(new Devilsberg\Webfetch\Cli\Command()->run($argv, STDOUT, STDERR));
